  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from langchain_google_genai import ChatGoogleGenerativeAI\n",
    "from langchain_core.tools import tool\n",
    "from langchain_core.messages import HumanMessage\n",
    "from langchain_community.tools import DuckDuckGoSearchRun\n",
    "import requests\n",
    "import re\n",
    "import time\n",
    "from selenium import webdriver\n",
    "from selenium.webdriver.common.by import By\n",
    "from selenium.webdriver.common.keys import Keys\n",
    "from selenium.webdriver.chrome.service import Service\n",
    "from webdriver_manager.chrome import ChromeDriverManager"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "search_tool = DuckDuckGoSearchRun()"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "@tool\n",
    "def multiply(text: str) -> str:\n",
    "    numbers = re.findall(r\"[-+]?\\d*\\.\\d+|\\d+\", text)\n",
    "    if len(numbers) != 2:\n",
    "        raise ValueError(\"Expected exactly two numbers in the input.\")\n",
    "    result = float(numbers[0]) * float(numbers[1])\n",
    "    return str(result)"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "@tool\n",
    "def get_weather_data(city: str) -> str:\n",
    "    api_key = os.environ.get(\"WEATHERSTACK_API_KEY\")\n",
    "    if not api_key:\n",
    "        return \"Weather API key not set.\"\n",
    "    url = f'https://api.weatherstack.com/current?access_key={api_key}&query={city}'\n",
    "    response = requests.get(url)\n",
    "    data = response.json()\n",
    "    if 'current' in data:\n",
    "        temp = data['current']['temperature']\n",
    "        return f\"The current temperature in {city} is {temp}°C.\"\n",
    "    else:\n",
    "        return \"Could not retrieve weather data.\""
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "@tool\n",
    "def play_youtube_video(video_name: str) -> str:\n",
    "    if not video_name:\n",
    "        raise ValueError(\"Please provide a video name.\")\n",
    "    options = webdriver.ChromeOptions()\n",
    "    options.add_argument(\"--start-maximized\")\n",
    "    driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)\n",
    "    try:\n",
    "        driver.get(\"https://www.youtube.com\")\n",
    "        time.sleep(2)\n",
    "        search_box = driver.find_element(By.NAME, \"search_query\")\n",
    "        search_box.send_keys(video_name)\n",
    "        search_box.send_keys(Keys.RETURN)\n",
    "        time.sleep(2)\n",
    "        videos = driver.find_elements(By.ID, \"video-title\")\n",
    "        if videos:\n",
    "            videos[0].click()\n",
    "        else:\n",
    "            driver.quit()\n",
    "            return \"No video found for the query.\"\n",
    "        return f\"Now playing: {video_name} on YouTube\"\n",
    "    except Exception as e:\n",
    "        return f\"Error: {str(e)}\""
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "llm = ChatGoogleGenerativeAI(model='gemini-1.5-pro')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from langchain.agents import create_react_agent, AgentExecutor\n",
    "from langchain import hub"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "prompt = hub.pull(\"hwchase17/react\")"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "agent = create_react_agent(\n",
    "    llm=llm,\n",
    "    prompt=prompt,\n",
    "    tools=[search_tool, get_weather_data, multiply, play_youtube_video]\n",
    ")"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "agent_executor = AgentExecutor(\n",
    "    agent=agent,\n",
    "    verbose=True\n",
    ")"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "response = agent_executor.invoke({\n",
    "    \"input\": \"Find the capital of Madhya Pradesh. Then find its current temperature. After that, multiply the temperature by 10. Then play some Bollywood songs on YouTube.\"\n",
    "})\n",
    "print(response)"
   ],
   "execution_count": null,
   "outputs": []
  }
