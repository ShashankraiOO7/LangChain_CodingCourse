    "import os\n",
    "os.environ[\"GOOGLE_API_KEY\"] = \"your_google_api_key_here\"\n",
    "os.environ[\"WEATHERSTACK_API_KEY\"] = \"your_weatherstack_api_key_here\""
   ],
   "execution_count": null,
